# Server-only settings. Never copy this file into dist/ or EXPO_PUBLIC_* variables.
# On Vercel: Storage -> add a Postgres database (Neon). It sets DATABASE_URL / POSTGRES_URL for you.
# Required by `npm run start:server` (Hostinger, VPS): the Neon POOLED connection string (host contains "-pooler").
# The server refuses to start without it unless PGLITE_DIR is set (local in-process database). See docs/HOSTINGER.md.
DATABASE_URL=
# Optional: Neon DIRECT connection string, used only to create/update the schema (migrations). Normal traffic stays pooled.
DATABASE_URL_UNPOOLED=
# Admin login. Without these, the default admin/admin login is used (change it!).
ADMIN_EMAIL=admin@example.com
# Generate with: ADMIN_PASSWORD='a-long-unique-password' node server/password.js
ADMIN_PASSWORD_HASH=
# Set to true once your own admin credentials work.
DISABLE_DEFAULT_ADMIN=false
COOKIE_SECURE=true
# For a separate frontend host, comma-separated origins (no paths).
APP_ORIGINS=http://localhost:8080
# Local Node server only: PGlite folder (default server/data/pglite, ':memory:' for tests) and static dist.
# PGLITE_DIR=
# STATIC_DIR=/path/to/dist
# Set by the host. Default: 3000 on Hostinger, 8080 elsewhere. The server listens on 0.0.0.0.
PORT=8080
# Long-running server tuning (defaults shown): DB connections, libuv threads, /api/sync memory cache, background timer.
# DB_POOL_MAX=5
# UV_THREADPOOL_SIZE=2
# SYNC_CACHE_MS=2000
# BACKGROUND_INTERVAL_MS=30000
# BACKGROUND_IDLE_MS=300000
# Trust the client address forwarded by a reverse proxy on the same machine (set automatically on Hostinger).
# TRUST_PROXY=true
# Protects the cron endpoint /api/push/pump (Vercel sends it as a Bearer token).
CRON_SECRET=
# Only trusted immediate reverse proxies; they must overwrite X-Real-IP.
TRUSTED_PROXY_IPS=
# Web Push keys are generated automatically and stored in the database. Set these only to pin your own.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Optional: native Android notifications (Firebase service-account JSON).
FCM_SERVICE_ACCOUNT_JSON=
# Seconds to wait for push delivery inside POST /api/requests (ms).
# PUSH_WAIT_MS=8000
# Cloudflare R2 media storage (images and videos). All five are required; without them media falls back to the database.
# See docs/r2-setup.md. Never expose these through EXPO_PUBLIC_* variables.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket URL (r2.dev or a custom domain such as https://media.example.com), no trailing slash.
R2_PUBLIC_BASE_URL=
# Optional: only for EU-jurisdiction buckets (https://<account>.eu.r2.cloudflarestorage.com) or a local S3 emulator.
# R2_ENDPOINT=
# Optional upload size limits in MB (defaults: images 10, videos 100).
# MEDIA_MAX_IMAGE_MB=10
# MEDIA_MAX_VIDEO_MB=100
# AI chat (free tiers). At least one key is needed for real answers; keys can also be pasted in /admin/assistant.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# Optional: order, model overrides and per-visitor messages per minute.
# CHAT_PROVIDER_ORDER=gemini,groq,openrouter,pollinations
# GEMINI_MODEL=
# GROQ_MODEL=
# OPENROUTER_MODEL=
# CHAT_RATE_LIMIT=20
